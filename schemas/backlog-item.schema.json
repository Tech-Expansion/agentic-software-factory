{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Tech-Expansion/agentic-software-factory/schemas/backlog-item.schema.json",
  "title": "Front matter of a backlog item (backlog/*.md)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^B-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "done"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "description": "1 is the most urgent."
    },
    "spec": {
      "type": "string",
      "description": "Path of the spec, relative to the product root."
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-[0-9]{3}$"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^B-[0-9]{4}$"
      }
    }
  }
}
