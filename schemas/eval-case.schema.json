{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Tech-Expansion/agentic-software-factory/schemas/eval-case.schema.json",
  "title": "An eval case (evals/cases/<id>/case.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "stack", "description", "suite", "hidden"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "kind": { "enum": ["build"] },
    "stack": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "suite": {
      "description": "regression: should stay near 100% and catch a version that got worse. capability: starts low and shows whether a change lets the factory do more.",
      "enum": ["regression", "capability"]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "hidden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check"],
      "properties": {
        "check": {
          "description": "Commands run in the product root after every item is merged, with hidden/ copied in. All must pass.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
