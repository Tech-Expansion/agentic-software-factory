{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Tech-Expansion/agentic-software-factory/schemas/verdict.schema.json",
  "title": "Verdict returned by a verifier step",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "criteria", "findings", "summary"],
  "properties": {
    "verdict": { "enum": ["pass", "fail"] },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["met", "not_met", "unverified"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": { "enum": ["blocker", "major", "minor"] },
          "message": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" }
  }
}
